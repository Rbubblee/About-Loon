#!name=充电桩修改
#!desc=极氪App家充桩页面实时显示并操作银河家充桩（v10.0 常态化：cron每5分钟用centerRefreshToken走/api/v1/login/refresh→oauth2/code→getTokenByCode自动换全套新token，authToken/refreshToken永不过期；实时/控制转发与兜底注入见v9.2）。建议先网页登录一次获取token。
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/充电桩修改.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=充电桩,家充桩,Zeekr,极氪,吉利银河
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EasyCharge.png
#!date=2026-08-10

[Argument]
enableInject=switch,true,tag=注入银河数据到极氪家充桩页面
autoRefresh=switch,true,tag=每30秒自动刷新银河数据（准实时，状态来源）
enableLogin=switch,true,tag=银河账号网页登录页（h5-recharge.geely.com/galaxy-login）
enableDebug=switch,false,tag=银河接口调试页（h5-recharge.geely.com/debug-galaxy）
notify=switch,true,tag=操作时弹通知

[Script]
; 同源代理（恒开）：登录页/调试页的 /api/v1、/gep 请求转发到真实网关，补回浏览器剥离的 Date/UA/Host/gl_user_id
http-request ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=800, requires-body=true, timeout=15, tag=charge.gw.relay.req
http-response ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=800, requires-body=true, timeout=15, tag=charge.gw.relay.resp
; 网页登录成功后把 token（含 refreshToken 过期时间 + centerToken/centerRefreshToken）写入 Loon persistentStore
http-response ^https:\/\/h5-recharge\.geely\.com\/store-token.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_store_token.js?v=1000, requires-body=true, timeout=10, tag=charge.store.token, enable={enableLogin}
; 实时转发+控制转发主通道：极氪设备/充电类请求 → 脚本内转发银河 api-recharge（原生签名+token）→ 返回实时结果（v9.2：Loon上原生请求只触发http-response，转发逻辑在脚本内按上下文处理）
http-request ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_inject_zeekr.js?v=902, requires-body=true, timeout=10, tag=charge.zeekr2galaxy, enable={enableInject}
; 兜底注入/实时转发（v9.2 主战场：http-response 上下文完成实时转发+控制转发+缓存/种子/合成兜底）
http-response ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_inject_zeekr.js?v=902, requires-body=true, timeout=10, tag=charge.inject, enable={enableInject}, argument=[{notify}]
; 银河接口调试页
http-response ^https:\/\/h5-recharge\.geely\.com\/debug-galaxy.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_debug_page.js?v=800, requires-body=true, timeout=10, tag=charge.debug, enable={enableDebug}, argument=[{notify}]
; 银河账号网页登录页（滑块+短信，替代银河App；getTokenByCode 响应由 capture 自动落库）
http-response ^https:\/\/h5-recharge\.geely\.com\/galaxy-login.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_galaxy_login.js?v=1000, requires-body=true, timeout=10, tag=charge.login, enable={enableLogin}, argument=[{notify}]
; 被动缓存（恒开）：打开银河App时兜底缓存 token/业务数据（可选增强，无开关）
http-response ^https:\/\/api-recharge\.geely\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_capture_galaxy.js?v=800, requires-body=true, timeout=10, tag=charge.capture, argument=[{notify}]
; 定时刷新：每30秒拉真实数据写缓存 + 每5分钟常态化换 token（注入的数据来源）
cron "*/30 * * * * *" script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=1000, tag=charge.refresh, enable={autoRefresh}
generic script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=1000, tag=charge.manual, img-url=bolt.fill, enable={autoRefresh}

[MitM]
hostname = sea-home-prod.haohanpower.tech, api-recharge.geely.com, h5-recharge.geely.com
