#!name=ZEEKR NOAD
#!desc=极氪App去广告与页面精简（v7.6：在 v7.5 基础上新增首方营销接口拦截——phone/bannerDeploy/*（首页Banner+文案、SDK弹窗、出行生活/我的页推广）、haohan-base-front/banner|popup、广告追踪上报；营销脚本深度清洗 marketingMaterialList 等字段；我的页推广位黑名单扩充并按跳转链接判定；保留头像/积分/订单等正常模块）
#!openUrl=https://apps.apple.com/app/id1572626106
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/Zeekr_remove_ads.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=去广告,极氪,Zeekr
#!date=2026-11-18

[Argument]
blockBrandCare=switch,true,tag=[浮窗]首页品牌关怀浮窗（邀好友得好礼）
blockUserRecommend=switch,true,tag=[我的]推荐位文案（邀试驾得好礼）
blockPopup=switch,true,tag=[弹窗]开屏弹窗+首页启动弹窗
blockCommunityPage=switch,true,tag=[社区]整页拦截（接口与H5请求不发送）
blockCommunityBanner=switch,true,tag=[社区]顶部Banner广告
blockCommunityContent=switch,true,tag=[社区]内容区(美图/九宫格/电台)
blockCommunityDiscovery=switch,true,tag=[社区]发现页活动推荐
blockHomepage=switch,true,tag=[首页]官方资讯+分类模块
blockProfileAds=switch,true,tag=[我的]主题专区等推广位（v7.6加固）
blockFirstPartyAds=switch,true,tag=[营销]首方Banner/弹窗/营销素材（v7.6新增）
blockActivityH5=switch,true,tag=[活动]活动H5页面
blockMarketing=switch,true,tag=[活动]营销消息推送
blockMall=switch,true,tag=[商城]整页拦截（接口与H5请求不发送）
debugNotify=switch,false,tag=调试通知（命中规则时弹提示）

[Rule]
; 本项目全部用 [Script] 处理，无需域名级阻断

[Rewrite]
; 空：Loon 3.5.x 实测插件内 URL Rewrite / response-body-json-jq 不生效，全部改为 [Script]

[Script]
; ================================================================
; 规则说明（2026-11-18 / v7.6）
;   · 首页浮窗（邀好友得好礼）真正的数据源是
;       POST api-gw-toc.zeekrlife.com/zeekrlife-app-user/anniversary/2022/open/getBrandCare415Info
;     请求体 {"bubbleType":"1"}，响应 data.{isShow,iconUrl,linkUrl,title}
;     → 只改 isShow=0 时新版 App 仍会渲染，故请求级直接合成空浮窗 + 响应级清空全部可渲染字段
;   · 我的页推广文案来自 zeekrlife-app-user/v1/user/info/home 的 data.recommendText
;   · 「我的」页/社区/弹窗的容器数据都在 zeekrlife-mp-bnr/open/v1/container/page
;   · v7.6 新增首方营销接口（来自 5.0.7 静态逆向报告）：
;       phone/bannerDeploy/action/queryHomeBannerAndCopyWriting
;       phone/bannerDeploy/action/queryPopupForSdk
;       phone/bannerDeploy/action/queryTravelLifeByPage
;       haohan-base-front/banner/get、haohan-base-front/popup/get
;       api/mpbnr/v1/open/toc/apple/adTrace/receive
;       zeekrlife-mp-bnr/toc/v1/popup/record/create
; ================================================================

; --- 社区整页：复用已在旧版加载过的脚本，避免新增远程脚本导致插件资源校验卡住 ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/(zeekrlife-bbs-theme\/|zeekrlife-search-api\/search\/api\/new\/getTopicList|zeekrlife-dod-search\/v2\/open\/search\/shading).*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.community.page.api, argument=[{blockCommunityPage},{debugNotify}], enable={blockCommunityPage}
http-request ^https?:\/\/zeekrlife-h5\.zeekrlife\.com\/pagesCommunity\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.community.page.h5, argument=[{blockCommunityPage},{debugNotify}], enable={blockCommunityPage}

; --- 商城整页：原生商城业务接口 + 商城H5/API统一返回本地空响应 ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/(zeekrlife-mp-cmall\/|pub\/v[0-9]+\/(article|category|combItem|comment|evaluation|goods|index|search|sts)\/|recommend\/v1\/goods\/|v[0-9]+\/(activity|goods|shoppingCart)\/).*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.mall.page.api, argument=[{blockMall},{debugNotify}], enable={blockMall}
http-request ^https?:\/\/zeekrlife-halvie-mall-uni-h5\.halvie\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.mall.page.h5, argument=[{blockMall},{debugNotify}], enable={blockMall}
http-request ^https?:\/\/zkmall-apigw\.halvie\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.mall.page.gw, argument=[{blockMall},{debugNotify}], enable={blockMall}

; --- 首页浮窗：请求级合成空响应（最彻底，不发上游） ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-app-user\/anniversary\/2022\/open\/getBrandCare.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_brandcare.js?v=2000, requires-body=false, timeout=10, tag=zeekr.brandcare.req, argument=[{blockBrandCare},{debugNotify}], enable={blockBrandCare}
; --- 首页浮窗：响应级兜底（万一请求级未生效） ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-app-user\/anniversary\/2022\/open\/getBrandCare.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_brandcare.js?v=2000, requires-body=true, timeout=10, tag=zeekr.brandcare.resp, argument=[{blockBrandCare},{debugNotify}], enable={blockBrandCare}

; --- 我的页推荐位文案（只清推广字段，昵称/头像/极分等正常数据不动） ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-app-user\/v1\/user\/info\/home(\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_userinfo_home.js, requires-body=true, timeout=10, tag=zeekr.userhome, argument=[{blockUserRecommend},{debugNotify}], enable={blockUserRecommend}

; --- 容器接口：弹窗 / 社区banner / 社区内容区 / 我的页推广位 ---
; 说明：不带 enable=，脚本内按 4 个开关独立判断，避免「关掉社区banner导致我的页过滤一起失效」
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_container.js, requires-body=true, timeout=10, tag=zeekr.container, argument=[{blockPopup},{blockCommunityBanner},{blockCommunityContent},{blockProfileAds},{debugNotify}]

; --- 社区发现页 / 卡片推荐 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-bbs-theme\/v1\/discovery\/pub\/list\/activitySessionListWithRecommendationsV2.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_discovery.js?v=2000, requires-body=true, timeout=10, tag=zeekr.discovery, argument=[{blockCommunityDiscovery},{debugNotify}], enable={blockCommunityDiscovery}
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-bbs-theme\/toc\/v1\/srv\/card\/list.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_discovery.js?v=2000, requires-body=true, timeout=10, tag=zeekr.cards, argument=[{blockCommunityDiscovery},{debugNotify}], enable={blockCommunityDiscovery}

; --- 首页低代码模块 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/toc\/v1\/lowPage\/open\/getView.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_homepage.js?v=2000, requires-body=true, timeout=10, tag=zeekr.homepage, argument=[{blockHomepage},{debugNotify}], enable={blockHomepage}

; --- 营销消息（原有 zeekrlife-mp-mkt） ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-mkt\/.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.marketing, argument=[{blockMarketing},{debugNotify}], enable={blockMarketing}

; ================================================================
; v7.6 新增：首方营销 / Banner / 弹窗接口（复用 zeekr_marketing.js，不新增远程脚本）
; ================================================================

; --- 首页 Banner + 推广文案（响应级深度清洗，保留正常字段） ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/phone\/bannerDeploy\/action\/queryHomeBannerAndCopyWriting.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.ads.homebanner, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}

; --- 出行生活 / 我的页推广位（响应级深度清洗） ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/phone\/bannerDeploy\/action\/queryTravelLifeByPage.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.ads.travel, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}

; --- SDK 弹窗（请求级直接合成空响应） ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/phone\/bannerDeploy\/action\/queryPopupForSdk.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=false, timeout=10, tag=zeekr.ads.sdkpopup.req, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/phone\/bannerDeploy\/action\/queryPopupForSdk.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.ads.sdkpopup.resp, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}

; --- 浩物 Banner / 弹窗（请求级直接合成空响应） ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/haohan-base-front\/banner\/get.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=false, timeout=10, tag=zeekr.ads.haohan.banner.req, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/haohan-base-front\/banner\/get.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.ads.haohan.banner.resp, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/haohan-base-front\/popup\/get.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=false, timeout=10, tag=zeekr.ads.haohan.popup.req, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/haohan-base-front\/popup\/get.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=true, timeout=10, tag=zeekr.ads.haohan.popup.resp, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}

; --- 广告追踪 / 弹窗曝光上报（请求级直接合成空响应） ---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/api\/mpbnr\/v1\/open\/toc\/apple\/adTrace\/receive.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=false, timeout=10, tag=zeekr.ads.trace, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/toc\/v1\/popup\/record\/create.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@1f10990/Script/zeekr_marketing.js, requires-body=false, timeout=10, tag=zeekr.ads.exposure, argument=[{blockFirstPartyAds},{debugNotify}], enable={blockFirstPartyAds}

; --- 活动H5（请求级拦截） ---
http-request ^https?:\/\/activity-h5\.zeekrlife\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js?v=2000, requires-body=false, timeout=10, tag=zeekr.activity.h5, argument=[{blockActivityH5},{debugNotify}], enable={blockActivityH5}

[MitM]
hostname = api-gw-toc.zeekrlife.com, activity-h5.zeekrlife.com, zeekrlife-h5.zeekrlife.com, zeekrlife-halvie-mall-uni-h5.halvie.com, zkmall-apigw.halvie.com
