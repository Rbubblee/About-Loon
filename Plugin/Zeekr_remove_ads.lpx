[Rule]

[Rewrite]
; 模块1: 品牌关怀浮窗 → isShow改为0 (图片来自548管理号)
^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-app-user\/anniversary\/2022\/open\/getBrandCare415Info$ response-body-json-jq '.data.isShow = 0'

; 模块2: 我的页面"主题专区限时开放" → 从HAIBAO容器中移除 (图片来自3692管理号)
^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page$ response-body-json-jq https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_service.jq

[Script]
; 待逐项添加

[MitM]
hostname = api-gw-toc.zeekrlife.com, zeekrlife-oss.zeekrlife.com, zeekrlife-h5.zeekrlife.com, zeekrlife-halvie-mall-uni-h5.halvie.com, zkmall-apigw.halvie.com, touchpoint-api.zeekrlife.com, im-web.zeekrlife.com, activity-h5.zeekrlife.com