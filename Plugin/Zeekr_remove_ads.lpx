[Argument]
; 逐个测试 - 默认全关, 验证通过再开
blockPopup=switch,false,tag=[弹窗]屏蔽APP开屏弹窗
blockCommunityBanner=switch,false,tag=[社区]移除社区顶部Banner广告
blockCommunityContent=switch,false,tag=[社区]移除社区内容区
blockMall=switch,false,tag=[商城]屏蔽极物商城
blockProfileAds=switch,false,tag=[我的]移除我的页面推广条目
blockTracking=switch,false,tag=[追踪]屏蔽第三方埋点上报
logLevel=select,"error","warn","info","debug","off",tag=日志等级

