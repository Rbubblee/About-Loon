#!name=ZEEKR NOAD
#!desc=极氪App去广告（v9.0：修复版。加载即弹"ZEEKR NOAD v9/脚本已加载运行"通知，进"我的"页看到它就说明脚本生效；精准清除「我的」页宝藏精选·作品上传/邀请好友/达人招募，社区顶部banner与开屏弹窗，保留服务大厅/卡包/极分/订单等正常功能）
#!openUrl=https://apps.apple.com/app/id1572626106
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/Zeekr_remove_ads.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=去广告,极氪,Zeekr
#!date=2026-11-18

[Argument]
debugNotify=switch,true,tag=调试通知（脚本加载即弹提示）

[Rule]
; 全部用 [Script] 处理

[Rewrite]
; 空

[Script]
; ================================================================
; v9.0 —— 极致精简，只保留一条核心规则：container/page
;   我的页「宝藏精选·作品上传」+ 邀请好友/达人招募：
;     POST api-gw-toc.zeekrlife.com/zeekrlife-mp-bnr/open/v1/container/page
;     data.records[tag=HAIBAO].places[] 逐位删推广位，保留功能位
;   社区顶部banner / 悬浮推广 / 开屏启动弹窗：同一接口的 tag=BBS
;
;   加载方式：沿用 v7.5 已验证能生效的 jsDelivr 固定 commit 地址
;   （raw.githubusercontent.com 在本机 Loon 多次证明加载不到脚本）
;   脚本一加载就弹通知，不依赖任何开关，一眼确认是否执行。
; ================================================================

; --- 核心：容器接口（我的页推广位 + 社区banner/悬浮 + 弹窗）---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page.*$ script-path=https://cdn.jsdelivr.net/gh/Rbubblee/About-Loon@495bbe46e5344fd92ef1b9aca1d34d4f91a9330d/Script/zeekr_container.js, requires-body=true, timeout=10, tag=zeekr.container.clean

[MitM]
hostname = api-gw-toc.zeekrlife.com
