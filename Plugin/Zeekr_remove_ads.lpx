#!name=ZEEKR NOAD
#!desc=极氪App去广告（v11.0：响应阶段修复版。v10 请求/响应共用同一脚本文件，Loon 按 script-path 去重导致响应清洗未执行——所以只弹了"命中"却没有"清理完成"。v11 拆成两个独立脚本文件，并改为通用递归清扫抗改版。进「我的」页应看到「响应脚本已执行」+「清理完成 · N 处」，宝藏精选·作品上传/邀请好友/达人招募被删，服务大厅/卡包/极分/订单保留）
#!openUrl=https://apps.apple.com/app/id1572626106
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/Zeekr_remove_ads.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=去广告,极氪,Zeekr
#!date=2026-11-18

[Rule]
; 全部用 [Script] 处理

[Rewrite]
; 空

[Script]
; ================================================================
; v11.0 —— 修响应阶段不执行
;   现象：v10 进"我的"页只弹「请求命中」，没有「清理完成」→ 广告还在。
;   判断：请求级与响应级指向同一个 script-path，Loon 对相同脚本文本去重，
;         只注册/执行了一次（请求那次），响应清洗被跳过。
;   修复：请求探针（zeekr_ping.js）与响应清洗（zeekr_noad_v11.js）拆成两个
;         完全独立的文件，互不复用。
;   注意：删掉旧插件再导入本版（同名插件直接刷新可能残留旧脚本缓存）。
; ================================================================

; --- 响应级：清洗 container/page（我的页推广位 + 社区banner/悬浮 + 弹窗）---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_noad_v11.js, requires-body=true, timeout=10, tag=zeekr.v11.resp

; --- 请求级探针（独立文件，仅用于确认需求链路；不改任何内容）---
http-request ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_ping.js, requires-body=false, timeout=10, tag=zeekr.v11.ping

[MitM]
hostname = api-gw-toc.zeekrlife.com
