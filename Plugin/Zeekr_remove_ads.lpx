#!name=极氪净化
#!desc=极氪App去广告 - 所有开关独立可控
#!openUrl=https://apps.apple.com/app/id1572626106
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/Zeekr_remove_ads.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=去广告,极氪,Zeekr
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/f8/a4/c3/f8a4c3f9-1569-d253-84ef-96c0c9eccc25/AppIcon-0-0-1x_U007epad-0-0-0-85-220.png/120x120bb.png
#!date=2026-07-28

[Argument]
blockBrandCare=switch,true,tag=[弹窗]品牌关怀浮窗
blockCommunityBanner=switch,true,tag=[社区]顶部Banner广告
blockCommunityContent=switch,true,tag=[社区]内容区(美图/九宫格/电台)
blockCommunityDiscovery=switch,true,tag=[社区]发现页活动推荐
blockHomepage=switch,true,tag=[首页]官方资讯+分类模块
blockProfileAds=switch,true,tag=[我的]主题专区限时开放
blockActivityH5=switch,true,tag=[活动]活动H5页面
blockMarketing=switch,true,tag=[活动]营销消息推送
blockMall=switch,true,tag=[商城]极物商城
logLevel=select,"error","warn","info","debug","off",tag=日志等级

[Rule]
; 域名级阻断(始终生效, [Rule]不支持enable=)
; 如需关闭, 可删掉对应行或注释掉

[Rewrite]
; 已全部移至[Script], 此段保留为空

[Script]
; ================================================================
; 所有规则都在此段, 通过 enable={开关} 独立控制
; ================================================================

; --- 弹窗 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-app-user\/anniversary\/2022\/open\/getBrandCare415Info$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_brandcare.js, requires-body=true, tag=zeekr.brandcare, enable={blockBrandCare}

; --- 社区 container/page (三合一, 脚本内根据argument值判断过滤什么) ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/open\/v1\/container\/page$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_container.js, requires-body=true, tag=zeekr.container, argument=[{blockCommunityBanner},{blockCommunityContent},{blockProfileAds}]

; --- 社区发现页 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-bbs-theme\/v1\/discovery\/pub\/list\/activitySessionListWithRecommendationsV2$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_discovery.js, requires-body=true, tag=zeekr.discovery, enable={blockCommunityDiscovery}
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-bbs-theme\/toc\/v1\/srv\/card\/list$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_discovery.js, requires-body=true, tag=zeekr.cards, enable={blockCommunityDiscovery}

; --- 首页 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-bnr\/toc\/v1\/lowPage\/open\/getView$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_homepage.js, requires-body=true, tag=zeekr.homepage, enable={blockHomepage}

; --- 营销消息 ---
http-response ^https?:\/\/api-gw-toc\.zeekrlife\.com\/zeekrlife-mp-mkt\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_marketing.js, requires-body=true, tag=zeekr.marketing, enable={blockMarketing}

; --- 活动H5 (拦截请求) ---
http-request ^https?:\/\/activity-h5\.zeekrlife\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js, requires-body=false, tag=zeekr.activity.h5, enable={blockActivityH5}

; --- 极物商城 (拦截请求) ---
http-request ^https?:\/\/zeekrlife-halvie-mall-uni-h5\.halvie\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js, requires-body=false, tag=zeekr.mall.h5, enable={blockMall}
http-request ^https?:\/\/zkmall-apigw\.halvie\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/zeekr_activity_mall.js, requires-body=false, tag=zeekr.mall.api, enable={blockMall}

[MitM]
hostname = api-gw-toc.zeekrlife.com, activity-h5.zeekrlife.com, zeekrlife-halvie-mall-uni-h5.halvie.com, zkmall-apigw.halvie.com