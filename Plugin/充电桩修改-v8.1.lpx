#!name=充电桩修改
#!desc=极氪App家充桩页面显示银河家充桩数据（v8.1 实时：进入家充桩页面即用银河token现场拉取对应接口再注入，不再等30秒；实时失败回退缓存/种子；控制类startCharge原生可用，读接口绑定校验在服务端只能靠注入绕过）。建议先网页登录一次获取token。
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/充电桩修改.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=充电桩,家充桩,Zeekr,极氪,吉利银河
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EasyCharge.png
#!date=2026-08-10

[Argument]
enableInject=switch,true,tag=注入银河数据到极氪家充桩页面
autoRefresh=switch,true,tag=每30秒自动刷新银河数据（准实时，状态来源）
enableLogin=switch,true,tag=银河账号网页登录页（h5-recharge.geely.com/galaxy-login）
enableDebug=switch,false,tag=银河接口调试页（h5-recharge.geely.com/debug-galaxy）
notify=switch,true,tag=操作时弹通知

[Script]
; 同源代理（恒开）：登录页/调试页的 /api/v1、/gep 请求转发到真实网关，补回浏览器剥离的 Date/UA/Host/gl_user_id
http-request ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=800, requires-body=true, timeout=15, tag=charge.gw.relay.req
http-response ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=800, requires-body=true, timeout=15, tag=charge.gw.relay.resp
; 网页登录成功后把 token（含 refreshToken 过期时间）写入 Loon persistentStore
http-response ^https:\/\/h5-recharge\.geely\.com\/store-token.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_store_token.js?v=800, requires-body=true, timeout=10, tag=charge.store.token, enable={enableLogin}
; 极氪家充桩设备类接口响应注入（原生+WebView 均生效；实时拉取银河数据；含 checkBindMyEquipment/getEquipmentExt 合成响应）
http-response ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_inject_zeekr.js?v=801, requires-body=true, timeout=10, tag=charge.inject, enable={enableInject}, argument=[{notify}]
; 银河接口调试页
http-response ^https:\/\/h5-recharge\.geely\.com\/debug-galaxy.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_debug_page.js?v=800, requires-body=true, timeout=10, tag=charge.debug, enable={enableDebug}, argument=[{notify}]
; 银河账号网页登录页（滑块+短信，替代银河App；getTokenByCode 响应由 capture 自动落库）
http-response ^https:\/\/h5-recharge\.geely\.com\/galaxy-login.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_galaxy_login.js?v=800, requires-body=true, timeout=10, tag=charge.login, enable={enableLogin}, argument=[{notify}]
; 被动缓存（恒开）：打开银河App时兜底缓存 token/业务数据（可选增强，无开关）
http-response ^https:\/\/api-recharge\.geely\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_capture_galaxy.js?v=800, requires-body=true, timeout=10, tag=charge.capture, argument=[{notify}]
; 定时刷新：每30秒用银河token拉取真实数据写入缓存（注入的数据来源）
cron "*/30 * * * * *" script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=800, tag=charge.refresh, enable={autoRefresh}
generic script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=800, tag=charge.manual, img-url=bolt.fill, enable={autoRefresh}

[MitM]
hostname = sea-home-prod.haohanpower.tech, api-recharge.geely.com, h5-recharge.geely.com
