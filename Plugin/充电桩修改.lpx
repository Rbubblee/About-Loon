#!name=充电桩修改
#!desc=极氪App家充桩页面显示银河家充桩数据（v5.3：恢复宽匹配捕获，打开银河App即缓存并注入；cron每30秒实时刷新需Loon脚本网络正常，内置连通性自检）。建议先打开一次银河App家充桩页以获取token。
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/充电桩修改.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=充电桩,家充桩,Zeekr,极氪,吉利银河
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EasyCharge.png
#!date=2026-08-07

[Argument]
enableInject=switch,true,tag=注入银河家充桩数据到极氪页面
captureData=switch,true,tag=打开银河App时自动缓存最新数据
autoRefresh=switch,true,tag=每30秒自动刷新银河数据（准实时）
notify=switch,true,tag=注入/缓存时弹通知

[Script]
; 极氪H5家充桩接口实时注入（只处理WebView请求，原生App请求自动放行）
http-response ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_inject_zeekr.js, requires-body=true, timeout=10, tag=charge.inject, enable={enableInject}, argument=[{notify}]
; 抓取银河App token/userId/业务数据并缓存（打开银河App家充桩页即刷新缓存；实时性由cron补充）
http-response ^https:\/\/api-recharge\.geely\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_capture_galaxy.js, requires-body=true, timeout=10, tag=charge.capture, enable={captureData}, argument=[{notify}]
; 定时刷新：每30秒用原生签名拉取银河实时数据写入缓存（无需打开银河App，token有效期内持续）
cron "*/30 * * * * *" script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js, tag=charge.refresh, enable={autoRefresh}
; 手动刷新：在Loon脚本页面点一下立即拉取银河数据（调试用）
generic script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js, tag=charge.manual, img-url=bolt.fill, enable={autoRefresh}

[MitM]
hostname = sea-home-prod.haohanpower.tech, api-recharge.geely.com
