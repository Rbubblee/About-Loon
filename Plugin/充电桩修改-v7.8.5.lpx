#!name=充电桩修改
#!desc=极氪App家充桩页面显示银河家充桩数据（v7.8.5：relay补回被Safari剥离的空值gl_user_id头，修复网关报「Header gl_user_id in X-Ca-Signature-Headers is Required」；v7.8.2起relay强制Host=目标网关修复空对象{}；改完请删除旧插件重新添加）。建议先打开一次银河App或使用网页登录获取token。
#!homepage=https://github.com/Rbubblee/About-Loon/blob/main/Plugin/充电桩修改.lpx
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.3.8(932)
#!author=Rbubblee
#!tag=充电桩,家充桩,Zeekr,极氪,吉利银河
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EasyCharge.png
#!date=2026-08-10

[Argument]
enableInject=switch,true,tag=注入银河家充桩数据到极氪页面
enableRedirect=switch,false,tag=改道：极氪H5设备请求改写为银河接口（实验性，开启会与注入冲突并触发网关403，默认关闭）
captureData=switch,true,tag=打开银河App时自动缓存最新数据
autoRefresh=switch,true,tag=每30秒自动刷新银河数据（准实时）
notify=switch,true,tag=注入/缓存时弹通知
enableDebug=switch,true,tag=银河接口调试页（浏览器打开 h5-recharge.geely.com/debug-galaxy）
enableLive=switch,true,tag=实时模式：极氪H5页面内实时拉取银河数据（需token有效）
enableMinimal=switch,false,tag=实验模式：只注入桩基本参数（设备列表+绑定判断），其余走极氪真实后端（验证时请关闭实时模式）
enableLogin=switch,true,tag=银河账号网页登录页（浏览器打开 h5-recharge.geely.com/galaxy-login）
enableGwRelay=switch,true,tag=同源代理（登录页/调试页/中继页必需，勿关）

[Script]
; 同源代理（脚本内转发）：/api/v1 -> galaxy-user-api，/gep -> api-recharge；补回浏览器剥离的 Date/UA/Host（否则网关验签403）。http-request 直接转发并返回响应；http-response 兜底替换已发出的403/404
http-request ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=785, requires-body=true, timeout=15, tag=charge.gw.relay.req, enable={enableGwRelay}
http-response ^https:\/\/h5-recharge\.geely\.com\/(api\/v1|gep|galaxy-gw|recharge-gw)\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_gw_relay.js?v=785, requires-body=true, timeout=15, tag=charge.gw.relay.resp, enable={enableGwRelay}
; 网页登录成功后把 token 写入 Loon persistentStore（用 http-response，请求发到 h5-recharge 的 404，由脚本替换响应并读取请求体）
http-response ^https:\/\/h5-recharge\.geely\.com\/store-token.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_store_token.js?v=783, requires-body=true, timeout=10, tag=charge.store.token, enable={enableLogin}
; 改道：极氪H5家充桩设备接口 -> 银河接口（原生签名+token，每次请求都是实时数据，无需脚本网络）
http-request ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_redirect_zeekr.js?v=783, requires-body=true, timeout=10, tag=charge.redirect, enable={enableRedirect}, argument=[{notify}]
; 极氪家充桩接口响应注入（原生 + WebView 均处理；含 checkBindMyEquipment/getEquipmentExt 合成响应；实验模式只注入桩基本参数）
http-response ^https:\/\/sea-home-prod\.haohanpower\.tech\/app\/equipment\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_inject_zeekr.js?v=783, requires-body=true, timeout=10, tag=charge.inject, enable={enableInject}, argument=[{notify},{minimal}]
; 银河接口调试页：挂在 h5-recharge.geely.com 下（该 Origin 被银河网关 CORS 白名单放行）
http-response ^https:\/\/h5-recharge\.geely\.com\/debug-galaxy.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_debug_page.js?v=783, requires-body=true, timeout=10, tag=charge.debug, enable={enableDebug}, argument=[{notify}]
; 银河账号网页登录页（滑块+短信，替代银河App；getTokenByCode 响应由 capture 自动落库）
http-response ^https:\/\/h5-recharge\.geely\.com\/galaxy-login.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_galaxy_login.js?v=784, requires-body=true, timeout=10, tag=charge.login, enable={enableLogin}, argument=[{notify}]
; 实时模式：中继页（白名单域名，处理极氪H5转发来的实时请求）
http-response ^https:\/\/h5-recharge\.geely\.com\/wallbox-relay.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_live_relay.js?v=783, requires-body=true, timeout=10, tag=charge.live.relay, enable={enableLive}
; 实时模式：客户端脚本（注入极氪H5，拦截设备类请求转发给中继页）
http-response ^https:\/\/h5-recharge\.geely\.com\/wallbox-client\.js.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_live_client.js?v=783, requires-body=true, timeout=10, tag=charge.live.client, enable={enableLive}
; 实时模式：向极氪H5 HTML 注入客户端脚本（只处理 HTML，其余资源放行）
http-response ^https:\/\/c-h5-prod\.haohanpower\.tech\/wallbox-sdk\/zeekr\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_live_inject.js?v=783, requires-body=true, timeout=10, tag=charge.live.inject, enable={enableLive}, argument=[{notify}]
; 抓取银河App token/userId/业务数据并缓存 + 给银河响应补CORS头（改道后浏览器跨域需要）
http-response ^https:\/\/api-recharge\.geely\.com\/.*$ script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_capture_galaxy.js?v=783, requires-body=true, timeout=10, tag=charge.capture, enable={captureData}, argument=[{notify}]
; 定时刷新：每30秒用原生签名拉取银河实时数据写入缓存（无需打开银河App，token有效期内持续）
cron "*/30 * * * * *" script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=783, tag=charge.refresh, enable={autoRefresh}
; 手动刷新：在Loon脚本页面点一下立即拉取银河数据（调试用）
generic script-path=https://raw.githubusercontent.com/Rbubblee/About-Loon/main/Script/charge_refresh_galaxy.js?v=783, tag=charge.manual, img-url=bolt.fill, enable={autoRefresh}

[MitM]
hostname = sea-home-prod.haohanpower.tech, api-recharge.geely.com, h5-recharge.geely.com, c-h5-prod.haohanpower.tech
